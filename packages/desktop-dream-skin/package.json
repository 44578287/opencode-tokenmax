  "description": "Dream Skin graft + mobile remote client for OpenCode",
  "bin": {
    "opencode-dream-skin": "./src/cli.ts"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
